rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required, immutable) - User's unique ID
    //   - displayName: string (optional) - User's name
    //   - photoURL: string (optional) - User's avatar URL
    //   - coins: number (required) - User's coin balance
    //   - gems: number (required) - User's gem balance
    //   - level: number (required) - User's level
    //   - xp: number (required) - User's experience points
    //   - selectedPieceId: string (optional) - Equipped piece ID
    //   - selectedStickerId: string (optional) - Equipped sticker ID
    //
    // Collection: users/{userId}/chests
    // Document ID: {chestId}
    // Fields:
    //   - uid: string (required, immutable) - Owner's ID
    //   - type: string (required) - Chest type (professional, master, supreme)
    //   - status: string (required) - Chest status (locked, unlocking, ready)
    //   - unlockTime: timestamp (optional) - Time when chest is ready
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'coins', 'gems', 'level', 'xp']) &&
             data.uid is string &&
             data.coins is number && data.coins >= 0 &&
             data.gems is number && data.gems >= 0 &&
             data.level is number && data.level >= 1 &&
             data.xp is number && data.xp >= 0 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500)) &&
             (!('selectedPieceId' in data) || (data.selectedPieceId is string && data.selectedPieceId.size() < 100)) &&
             (!('selectedStickerId' in data) || (data.selectedStickerId is string && data.selectedStickerId.size() < 100));
    }

    function isValidChest(data) {
      return data.keys().hasAll(['uid', 'type', 'status']) &&
             data.uid is string &&
             data.type in ['professional', 'master', 'supreme'] &&
             data.status in ['locked', 'unlocking', 'ready'] &&
             (!('unlockTime' in data) || data.unlockTime is timestamp);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "svosoftware@gmail.com" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // Users can only read their own profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can only create their own profile with initial values
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.role == 'user';
      
      // Users can only update their own profile, and cannot change their role or uid
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.role == resource.data.role;
    }

    match /users/{userId}/chests/{chestId} {
      // Users can only access their own chests
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Validate chest data on write
      allow create, update: if isOwner(userId) && isValidChest(request.resource.data) &&
                              request.resource.data.uid == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
